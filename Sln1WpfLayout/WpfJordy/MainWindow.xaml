<Window x:Class="WpfJordy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfJordy"
        mc:Ignorable="d"
        Title="MainWindow"
        Width="760"
        MinWidth="400"
        Height="800"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Beige">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="/Images/logo.png"
                   Width="95"
                   Margin="18,14,0,14"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Stretch="Uniform"/>

            <TextBlock Grid.Column="1"
                       Text="red Jordy"
                       FontFamily="Broadway"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="2"
                    Content="LOGIN"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,16,0"
                    Padding="9,4"
                    BorderThickness="0"
                    Background="LightGray"
                    FontSize="11"/>
        </Grid>

        <Grid Grid.Row="1" Margin="12,12,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" HorizontalAlignment="Center">
                <Border Width="160" Height="120" Margin="8" ClipToBounds="True">
                    <Image Source="/Images/jordy1.jpg" Stretch="UniformToFill"/>
                </Border>
                <Border Width="160" Height="120" Margin="8" ClipToBounds="True">
                    <Image Source="/Images/jordy2.jpg" Stretch="UniformToFill"/>
                </Border>
                <Border Width="160" Height="120" Margin="8" ClipToBounds="True">
                    <Image Source="/Images/jordy3.jpg" Stretch="UniformToFill"/>
                </Border>
                <Border Width="160" Height="120" Margin="8" ClipToBounds="True">
                    <Image Source="/Images/jordy4.jpg" Stretch="UniformToFill"/>
                </Border>
            </WrapPanel>

            <Grid Grid.Row="1" Margin="4,4,4,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           FontSize="12"
                           LineHeight="22"
                           VerticalAlignment="Top">
                    <Bold>Naam:</Bold> Jordy
                    <LineBreak/>
                    <Bold>Leeftijd:</Bold> 6 maanden
                    <LineBreak/>
                    <Bold>Geslacht:</Bold> mannetje
                    <LineBreak/>
                    <Bold>Gewicht:</Bold> 12kg
                </TextBlock>

                <TextBlock Grid.Column="2"
                           FontSize="12"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top">
                    Hallo, ik ben Jordy! Ik hou van wandelen, kinderen en andere huisdieren. Ad veertien er al slagen resident. Waaronder eindelijk schatist mee men wat britschen visschers. Is om te markten streken en vrouwen.
                </TextBlock>
            </Grid>

            <Grid Grid.Row="2"
                  MaxWidth="500"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="95"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,14"
                           FontSize="16"
                           FontStyle="Italic"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           LineHeight="24"
                           HorizontalAlignment="Left">
                    Wordt Jordy jouw nieuw maatje? Stuur hem een bericht!
                </TextBlock>

                <Label Grid.Row="1"
                       Content="Naam:"
                       FontWeight="Bold"
                       FontSize="12"
                       Padding="0"
                       HorizontalContentAlignment="Left"/>

                <TextBox Grid.Row="2"
                         Margin="0,3,0,10"
                         BorderBrush="LightBlue"
                         BorderThickness="1"
                         
                         Foreground="Gray"
                         FontSize="12"
                         VerticalContentAlignment="Center"
                         Text="jouw naam"/>

                <Label Grid.Row="3"
                       Content="Straat:"
                       FontWeight="Bold"
                       FontSize="12"
                       Padding="0"
                       HorizontalContentAlignment="Left"/>

                <TextBox Grid.Row="4"
                         Margin="0,3,0,10"
                         BorderBrush="LightBlue"
                         BorderThickness="1"
                         
                         Foreground="Gray"
                         FontSize="12"
                         VerticalContentAlignment="Center"
                         Text="jouw straat"/>

                <Grid Grid.Row="5" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Content="Postcode:"
                           FontWeight="Bold"
                           FontSize="12"
                           Padding="0"
                           HorizontalContentAlignment="Left"/>

                    <Label Grid.Row="0"
                           Grid.Column="2"
                           Content="Gemeente:"
                           FontWeight="Bold"
                           FontSize="12"
                           Padding="0"
                           HorizontalContentAlignment="Left"/>

                    <TextBox Grid.Row="1"
                             Grid.Column="0"
                             Margin="0,3,0,0"
                             BorderBrush="LightBlue"
                             BorderThickness="1"
                             Padding="8,4"
                             Foreground="Gray"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             Text="b.v. 2500"/>

                    <TextBox Grid.Row="1"
                             Grid.Column="2"
                             Margin="0,3,0,0"
                             BorderBrush="LightBlue"
                             BorderThickness="1"
                             Padding="8,4"
                             Foreground="Gray"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             Text="b.v. Lier"/>
                </Grid>

                <Label Grid.Row="7"
                       Content="Bericht:"
                       FontWeight="Bold"
                       FontSize="12"
                       Padding="0"
                       HorizontalContentAlignment="Left"/>

                <TextBox Grid.Row="8"
                         Margin="0,3,0,12"
                         BorderBrush="LightBlue"
                         BorderThickness="1"
                         
                         Foreground="Gray"
                         FontSize="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Center"
                         Text="b.v. Lier"/>

                <Button Grid.Row="9"
                        Content="VERZENDEN"
                        HorizontalAlignment="Right"
                        Padding="9,4"
                        BorderThickness="0"
                        Background="LightGray"
                        FontSize="11"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="Beige">
            <TextBlock Text="copyright 2024, verbond van dakloze dieren"
                       FontSize="10"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>