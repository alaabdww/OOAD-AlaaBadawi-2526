<Window x:Class="WpfVcardEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfVcardEditor"
        mc:Ignorable="d"
        Title="VCARD EDITOR" Height="450" Width="600"
        MinWidth="500">
   <DockPanel LastChildFill="True">
      <Menu DockPanel.Dock="Top">
         <MenuItem Header="vCard">
            <MenuItem Header="New" Name="mnuNew" Click="mnuNew_Click"/>
            <MenuItem Header="Open..." Name="mnuOpen" Click="mnuOpen_Click"/>
            <MenuItem Header="Save" Name="mnuSave" IsEnabled="False" Click="mnuSave_Click"/>
            <MenuItem Header="Save As..." Name="mnuSaveAs" IsEnabled="False" Click="mnuSaveAs_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Name="mnuExit" Click="mnuExit_Click"/>
         </MenuItem>
         <MenuItem Header="Help">
            <MenuItem Header="About" Name="mnuAbout" Click="MnuAbout_Click"/>
         </MenuItem>
      </Menu>

      <StatusBar DockPanel.Dock="Bottom">
         <StatusBarItem Padding="10,5">
            <TextBlock Name="tblCurrentCard" Text="huidige kaart: (geen geopend)"/>
         </StatusBarItem>
         <StatusBarItem Padding="10,5" HorizontalAlignment="Right">
            <TextBlock Name="tblPercentage" Text="percentage ingevuld: n.a."/>
         </StatusBarItem>
      </StatusBar>

      <TabControl Name="tabMain" Margin="5">

         <TabItem Header="Persoonlijk" Name="tabPersonal">
            <Grid Margin="10">
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*" MaxWidth="600"/>
               </Grid.ColumnDefinitions>
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
               </Grid.RowDefinitions>

               <Label Content="Voornaam" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
               <TextBox Name="txtFirstname" Grid.Row="0" Grid.Column="1" Margin="0,5" VerticalAlignment="Center" TextChanged="Field_Changed"/>

               <Label Content="Achternaam" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
               <TextBox Name="txtLastname" Grid.Row="1" Grid.Column="1" Margin="0,5" VerticalAlignment="Center" TextChanged="Field_Changed"/>

               <Label Content="Geboortedatum" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
               <DatePicker Name="datBirthday" Grid.Row="2" Grid.Column="1" Margin="0,5" HorizontalAlignment="Left" VerticalAlignment="Center" SelectedDateChanged="Field_Changed"/>

               <Label Content="Geslacht" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
               <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                  <RadioButton Name="rdnFemale" Content="vrouw" GroupName="Gender" VerticalAlignment="Center" Margin="0,0,5,0" Checked="Field_Changed"/>
                  <RadioButton Name="rdnMale" Content="man" GroupName="Gender" VerticalAlignment="Center" Margin="0,0,5,0" Checked="Field_Changed"/>
                  <RadioButton Name="rdnUnknown" Content="onbekend" GroupName="Gender" VerticalAlignment="Center" Checked="Field_Changed"/>
               </StackPanel>

               <Label Content="Privé email" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
               <TextBox Name="txtPrivateEmail" Grid.Row="4" Grid.Column="1" Margin="0,5" VerticalAlignment="Center" TextChanged="Field_Changed"/>

               <Label Content="Privé telefoon" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
               <TextBox Name="txtPrivatePhone" Grid.Row="5" Grid.Column="1" Margin="0,5" VerticalAlignment="Center" TextChanged="Field_Changed"/>

               <Label Content="Foto" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
               <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                  <Button Name="btnSelectPhoto" Content="SELECTEER..." Width="90" Margin="0,0,5,0" VerticalAlignment="Center" Click="btnSelectPhoto_Click"/>
                  <TextBlock Name="tblPhotoName" Text="(geen geselecteerd)" VerticalAlignment="Center"/>
               </StackPanel>

               <Image Name="imgPreview" Grid.Row="7" Grid.Column="1" Width="100" Height="100" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5" Stretch="Uniform"/>

            </Grid>
         </TabItem>

         <TabItem Header="Werk" Name="tabWork">
            <Grid Margin="10">
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*" MaxWidth="600"/>
               </Grid.ColumnDefinitions>
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
               </Grid.RowDefinitions>

               <Label Content="Bedrijf" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
               <TextBox Name="txtCompany" Grid.Row="0" Grid.Column="1" Margin="0,5" VerticalAlignment="Center"/>

               <Label Content="Jobtitel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
               <TextBox Name="txtJobTitle" Grid.Row="1" Grid.Column="1" Margin="0,5" VerticalAlignment="Center"/>

               <Label Content="Werk email" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
               <TextBox Name="txtWorkEmail" Grid.Row="2" Grid.Column="1" Margin="0,5" VerticalAlignment="Center"/>

               <Label Content="Werk telefoon" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
               <TextBox Name="txtWorkPhone" Grid.Row="3" Grid.Column="1" Margin="0,5" VerticalAlignment="Center"/>
            </Grid>
         </TabItem>

         <TabItem Header="Sociaal" Name="tabSocial">
            <Grid Margin="10">
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*" MaxWidth="600"/>
               </Grid.ColumnDefinitions>
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
               </Grid.RowDefinitions>

               <Label Content="LinkedIn" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
               <TextBox Name="txtLinkedIn" Grid.Row="0" Grid.Column="1" Margin="0,5" VerticalAlignment="Center"/>

               <Label Content="Facebook" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
               <TextBox Name="txtFacebook" Grid.Row="1" Grid.Column="1" Margin="0,5" VerticalAlignment="Center"/>

               <Label Content="Instagram" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
               <TextBox Name="txtInstagram" Grid.Row="2" Grid.Column="1" Margin="0,5" VerticalAlignment="Center"/>

               <Label Content="Youtube" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
               <TextBox Name="txtYoutube" Grid.Row="3" Grid.Column="1" Margin="0,5" VerticalAlignment="Center"/>
            </Grid>
         </TabItem>

      </TabControl>



   </DockPanel>
        
</Window>
