<Window x:Class="WpfVcardEditor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfVcardEditor"
        mc:Ignorable="d"
        Title="About vCard Editor" Height="350" Width="300" WindowStyle="ToolWindow" ResizeMode="NoResize">
    <Grid>
      <StackPanel Margin="20">

         <Image Source="/img/logo.png" Height="80"  Margin="0,20"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Stretch="Uniform"/>

         <TextBlock Margin="0,0,0,5">
            <Bold>Gemaakt door:</Bold> Rogier van der Linde
         </TextBlock>
         <TextBlock Margin="0,0,0,5">
            <Bold>Vak:</Bold> OO Application Development
         </TextBlock>
         <TextBlock Margin="0,0,0,20">
            <Bold>Academiejaar:</Bold> 2025 — 2026
         </TextBlock>

         <Button Name="btnClose" Content="SLUITEN"
                Width="100" Padding="10,5"
                HorizontalAlignment="Center"
                Click="BtnClose_Click"/>

      </StackPanel>
   </Grid>
</Window>
