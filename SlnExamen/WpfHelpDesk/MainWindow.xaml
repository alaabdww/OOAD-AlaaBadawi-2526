<Window x:Class="WpfHelpDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfHelpDesk"
        mc:Ignorable="d"
        Title="IT Helpdesk" Height="620" Width="900"
        MinHeight="520" MinWidth="800">
    <!-- Hoofdlayout: 30% filters + lijst, 70% details + formulier -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <!-- Kolom 1: filters en ticketlijst -->
        <Grid Grid.Column="0" Margin="0,0,10,0"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <TextBlock Text="Filters" FontWeight="Bold" FontSize="14"
                           Margin="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <Label Content="Prioriteit" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <ComboBox x:Name="cmbFilterPrioriteit" Margin="0,0,0,8"
                          HorizontalAlignment="Stretch" VerticalAlignment="Top"/>

                <Label Content="Melder" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <ComboBox x:Name="cmbFilterMelder" Margin="0,0,0,8"
                          HorizontalAlignment="Stretch" VerticalAlignment="Top"/>

                <CheckBox x:Name="chkAlleenOpen" Content="Alleen open tickets" Margin="0,0,0,8"
                          HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </StackPanel>

            <ListBox x:Name="lbxTickets" Grid.Row="1"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>

        <!-- Kolom 2: details, acties en nieuw ticket -->
        <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Details" FontWeight="Bold" FontSize="14"
                       Margin="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <TextBlock x:Name="txtDetails"
                       Grid.Row="1"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       FontSize="13"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <!-- Validatie- en statusmelding bij geselecteerd ticket -->
            <TextBlock x:Name="txtValidatieTicket"
                       Grid.Row="2"
                       TextWrapping="Wrap"
                       Foreground="DarkRed"
                       Margin="0,0,0,8"
                       FontSize="12"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <!-- Disabled tot een open ticket geselecteerd is -->
            <Button x:Name="btnTicketAfsluiten"
                    Grid.Row="3"
                    Content="Ticket afsluiten"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="12,6"
                    Margin="0,0,0,16"
                    IsEnabled="False"/>

            <Border Grid.Row="4"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Padding="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <TextBlock Text="Nieuw ticket" FontWeight="Bold" FontSize="14"
                               Margin="0,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                    <Label Content="Titel" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtNieuweTitel" Margin="0,0,0,8"
                             HorizontalAlignment="Stretch" VerticalAlignment="Top"
                             MaxLength="100"/>

                    <Label Content="Melder" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <ComboBox x:Name="cmbNieuweMelder" IsEditable="True" Margin="0,0,0,8"
                              HorizontalAlignment="Stretch" VerticalAlignment="Top"/>

                    <Label Content="Prioriteit" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <ComboBox x:Name="cmbNieuwePrioriteit" Margin="0,0,0,8"
                              HorizontalAlignment="Stretch" VerticalAlignment="Top"/>

                    <Label Content="Type" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <ComboBox x:Name="cmbNieuweType" Margin="0,0,0,8"
                              HorizontalAlignment="Stretch" VerticalAlignment="Top"/>

                    <Label Content="Toestel" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtNieuweToestel" Margin="0,0,0,8"
                             HorizontalAlignment="Stretch" VerticalAlignment="Top"
                             MaxLength="80"/>

                    <!-- Validatie- en statusmelding bij nieuw ticket -->
                    <TextBlock x:Name="txtValidatieNieuw"
                               TextWrapping="Wrap"
                               Foreground="DarkRed"
                               Margin="0,0,0,8"
                               FontSize="12"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>

                    <!-- Disabled tot alle verplichte velden geldig ingevuld zijn -->
                    <Button x:Name="btnToevoegen"
                            Content="Toevoegen"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Padding="12,6"
                            IsEnabled="False"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
