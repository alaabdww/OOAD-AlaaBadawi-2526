<Window x:Class="WpfTaken.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfTaken"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="0"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Taak:" VerticalAlignment="Center" Height="25"/>
            <TextBox Name="txtTaak" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" Margin="0,4,0,5"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Prioriteit:" VerticalAlignment="Center" Height="25"/>
            <ComboBox Name="cmbPrioriteit" Grid.Row="2" Grid.Column="1" Margin="0,4,0,5">
                <ComboBoxItem Content="selecteer..." IsSelected="True"/>
                <ComboBoxItem Content="laag"/>
                <ComboBoxItem Content="gemiddeld"/>
                <ComboBoxItem Content="hoog"/>
            </ComboBox>

            <Label Grid.Row="4" Grid.Column="0" Content="Deadline:" VerticalAlignment="Center" Height="25"/>
            <DatePicker Name="dpDeadline" Grid.Row="4" Grid.Column="1" Margin="0,4,0,5"/>

            <Label Grid.Row="6" Grid.Column="0" Content="Door:" VerticalAlignment="Center" Height="25"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Height="15">
                <RadioButton Name="rbAdam" Content="Adam" GroupName="naam" Margin="0,0,10,0"/>
                <RadioButton Name="rbBilal" Content="Bilal" GroupName="naam" Margin="0,0,10,0"/>
                <RadioButton Name="rbChelsey" Content="Chelsey" GroupName="naam"/>
            </StackPanel>

            <Button Name="btnToevoegen"
                    Grid.Row="8"
                    Grid.Column="1"
                    Width="105"
                    HorizontalAlignment="Left"
                    Content="TOEVOEGEN »"
                    Click="btnToevoegen_Click" Margin="105,2,0,3"/>

            <TextBlock Name="txtError"
                       Grid.Row="10"
                       Grid.ColumnSpan="2"
                       Text=""
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" Height="80"/>
        </Grid>

        <ListBox Name="lstTaken"
                 Grid.Column="2"
                 Grid.Row="0"
                 Margin="0,0,0,10"/>

        <StackPanel Grid.Column="2"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
            <Button Name="btnTerugzetten" 
                    Content="TERUGZETTEN"
                    Width="95"
                    Height="32"
                    Margin="0,0,18,0"
                    IsEnabled="False"/>
            <Button Name="btnVerwijderen" 
                    Content="VERWIJDEREN"
                    Width="95"
                    Height="32"
                    IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>